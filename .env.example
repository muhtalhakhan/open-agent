# Required: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, LM Studio, ...)
# Pointed at a vendor with its own conventional variable, that name is accepted
# too and wins over OPENAI_API_KEY: OPENROUTER_API_KEY for openrouter.ai,
# ANTHROPIC_API_KEY for anthropic.com, GEMINI_API_KEY for googleapis.com.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Every credential below also accepts a <NAME>_FILE variant naming a file that
# holds the value — the shape Docker and Kubernetes secrets arrive in, and one
# that keeps the key out of the process environment. A trailing newline is
# trimmed. Set at most one of the two spellings; the direct variable wins.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# Optional: enable browser tools (needs `pip install browser-use`, Python 3.11+).
# Each run gets a throwaway browser profile — no cookies, no saved logins, no
# history — which is removed when the run ends. BROWSER_PROFILE_DIR points it at
# a directory instead, and naming your real Chrome profile there hands the agent
# a browser already logged into everything you are: every one of those sessions
# is reachable by whatever page it visits. BROWSER_ALLOW_ENV names credential
# variables to pass through to browser-use, which otherwise sees none of them.
BROWSER_USE=0
# BROWSER_PROFILE_DIR=/home/you/.config/google-chrome
# BROWSER_KEEP_PROFILE=0
# BROWSER_ALLOW_ENV=GH_TOKEN

# Optional: enable the shell tools — run_command for a command that finishes,
# and start_process/list_processes/read_process_output/stop_process for one
# that does not. Background processes are killed when the run ends. Every call
# needs approval. SHELL_ROOT is where commands run (falls back to FILES_ROOT,
# then the launch directory). SHELL_ALLOWED_COMMANDS narrows it to a list of
# programs; SHELL_ALLOW_ENV names credential variables to pass through that the
# tool would otherwise hide from the command.
#
# Commands run inside a sandbox. SHELL_SANDBOX picks the backend — auto (the
# default: bubblewrap where the kernel allows it, else Docker), bubblewrap,
# docker, or none. There is no automatic fall-through to none: if no backend
# works the shell tools are not registered at all, and you have to set none
# yourself to accept running commands with your own privileges. The filesystem
# is read-only apart from the workspace, and there is no network unless
# SHELL_NETWORK=1. SHELL_SANDBOX_IMAGE is the Docker image — the default has a
# shell and little else, so set one carrying the toolchain your commands need.
SHELL_TOOL=0
# SHELL_ROOT=/path/to/workspace
# SHELL_SANDBOX=auto
# SHELL_SANDBOX_IMAGE=node:22-alpine
# SHELL_NETWORK=0
# SHELL_ALLOWED_COMMANDS=git,npm,ls,cat
# SHELL_ALLOW_ENV=GH_TOKEN
# SHELL_TIMEOUT_MS=120000

# Optional: enable the http_request tool (direct calls to arbitrary REST APIs).
# Every call still needs approval. HTTP_ALLOWED_HOSTS narrows where it may go
# (comma-separated; a bare domain also covers its subdomains) — leave it unset
# for no restriction. Each HTTP_SECRET_<NAME> becomes a {{NAME}} placeholder the
# model can put in a header or URL without ever seeing the value.
HTTP_TOOL=0
# HTTP_ALLOWED_HOSTS=api.github.com,api.stripe.com
# HTTP_SECRET_GITHUB_TOKEN=ghp_...

# Optional: give this run its own throwaway workspace directory instead of
# working in FILES_ROOT. Two agents running at once then cannot see or clobber
# each other's files, and the directory is deleted when the run ends.
# WORKSPACE_BASE is where those directories are created (default: the OS temp
# dir). This is a directory per session; the sandbox that contains what a
# command can reach is separate, see SHELL_SANDBOX above.
WORKSPACE_SESSION=0
# WORKSPACE_BASE=/var/lib/open-agent

# Optional: enable the filesystem tools — read_file, list_directory,
# search_files and write_file. All four are confined to FILES_ROOT (the
# directory you launched the CLI from unless set), so point it at the workspace
# you want the agent to see. Reading, listing and searching need no per-call
# approval; every write is prompted for.
#
# Secrets inside that root are excluded by default — .env, *.pem, *.key,
# id_rsa, .ssh/**, .aws/credentials, .npmrc and friends. Denied files cannot be
# read or written, and are left out of listings and search results too.
# .env.example and its siblings are carved back out, being names without
# values. FILES_DENY adds patterns, FILES_ALLOW carves them back out, and
# FILES_READONLY refuses every write outright. Note that run_command is not
# bound by any of this: a shell command can read whatever your user can.
FILES_TOOL=0
# FILES_ROOT=/path/to/workspace
# FILES_DENY=internal/**,*.bak
# FILES_ALLOW=.env.local
# FILES_READONLY=0

# Optional: web search (the web_search tool). Set at most one; brave wins if
# both are set. Unset both and the tool is not registered at all.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional: long-term memory. Set at most one; unset both to use the
# dependency-free in-memory provider (no persistence across runs).
SUPERMEMORY_API_KEY=
SUPERMEMORY_BASE_URL=
MEM0_API_KEY=

# Optional: scopes memory to a specific user/container (default: "cli-user")
CLI_USER_ID=

# Optional: print structured step-by-step logs from the agent loop
DEBUG=
