{
  "name": "open-agent",
  "private": true,
  "version": "0.1.0",
  "description": "An open-source, self-hosted, provider-agnostic AI agent runtime.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "echo \"no lint configured yet\"",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "cli": "npm run start --workspace @open-agent/cli",
    "example:research": "tsx examples/research-and-report.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
